                    <ServiceImplementation
                     description=""
                     handlerName="Script"
                     name="AddPricingMatrixRow">
                        <ConfigurationTables>
                            <ConfigurationTable
                             dataShapeName=""
                             description=""
                             isMultiRow="false"
                             name="Script"
                             ordinal="0">
                                <DataShape>
                                    <FieldDefinitions>
                                        <FieldDefinition
                                         baseType="STRING"
                                         description="code"
                                         name="code"
                                         ordinal="0"></FieldDefinition>
                                    </FieldDefinitions>
                                </DataShape>
                                <Rows>
                                    <Row>
                                        <code>
                                        <![CDATA[
                                        let result = "";
                                        
                                        try {
                                        
                                            let nextBandNumber = 8;
                                        
                                            let allRows = Things["PricingMatrix.DT"].GetDataTableEntries({
                                                maxItems: 500
                                            });
                                        
                                            for (let i = 0; i < allRows.rows.length; i++) {
                                        
                                                let band = allRows.rows[i].StopsBand;
                                        
                                                if (band && band.indexOf("New band ") === 0) {
                                        
                                                    let num = parseInt(
                                                        band.replace("New band ", ""),
                                                        10
                                                    );
                                        
                                                    if (!isNaN(num) && num >= nextBandNumber) {
                                                        nextBandNumber = num + 1;
                                                    }
                                                }
                                            }
                                        
                                            let tags = [];
                                        
                                            let values = Things["PricingMatrix.DT"].CreateValues();
                                        
                                            // Auto-generate StopsBand
                                            values.StopsBand = "New band " + nextBandNumber;
                                        
                                            values.Capacity200 = Capacity200;
                                            values.Capacity1000 = Capacity1000;
                                            values.Capacity1600 = Capacity1600;
                                            values.Capacity2000_3000 = Capacity2000_3000;
                                        
                                            Things["PricingMatrix.DT"].AddOrUpdateDataTableEntry({
                                                tags: tags,
                                                source: me.name,
                                                values: values
                                            });
                                        
                                            result = "Success";
                                        
                                        } catch (e) {
                                        
                                            result = "Failed: " + e.message;
                                        
                                            logger.error(
                                                "Service: AddPricingMatrixRow, Exception: " +
                                                e.message +
                                                ", Line Number: " +
                                                e.lineNumber
                                            );
                                        }
                                        
                                        result;
                                        ]]>
                                        </code>
                                    </Row>
                                </Rows>
                            </ConfigurationTable>
                        </ConfigurationTables>
